# Port serwera
PORT=3000

# Klucze API (można również wprowadzić bezpośrednio w interfejsie aplikacji)
ELEVENLABS_API_KEY=twoj_klucz_elevenlabs
ANTHROPIC_API_KEY=twoj_klucz_anthropic
GOOGLE_API_KEY=twoj_klucz_google
GEMINI_API_KEY=twoj_klucz_gemini
GROQ_API_KEY=twoj_klucz_groq
# Klucz OpenAI (GPT, TTS, Transcribe) - działa też standardowa nazwa OPENAI_API_KEY
OPEN_API_KEY=twoj_klucz_openapi

# Model STT (Speech-to-Text)
# Opcje: gemini-3.5-transcribe, gemini-3.6-flash, web_speech (Google), whisper-large-v3-turbo, whisper-large-v3 (Groq), gpt-transcribe, gpt-4o-transcribe, gpt-4o-mini-transcribe, whisper-1 (OpenAI), scribe_v2, scribe_v1 (ElevenLabs)
STT_MODEL=gemini-3.5-transcribe

# Model AI (LLM)
# Opcje: gemini-3.6-flash, gemini-flash-latest, gemini-3.8-flash, gemini-2.5-pro (Google), claude-opus-5, claude-sonnet-5, claude-haiku-4-5-20251001 (Claude), gpt-5.6-luna, gpt-5.6-terra, gpt-5.6-sol, gpt-6-astra (OpenAI)
AI_MODEL=gemini-3.6-flash
CLAUDE_MODEL=claude-opus-5

# Model TTS & Głos (Text-to-Speech)
# Głosy: google-gemini-neural, pl-PL-Wavenet-A, pl-PL-Wavenet-B, pl-PL-Wavenet-D, pl-PL-MarekNeural, pl-PL-ZofiaNeural (Google/Edge), openai-marin, openai-cedar, openai-alloy, openai-coral, openai-nova, openai-onyx (OpenAI), EXAVITQu4vr4xnSDxMaL (ElevenLabs)
# Modele TTS: gemini-2.5-flash-preview-tts, google-cloud-wavenet, edge-neural, gpt-4o-mini-tts, tts-1-hd, tts-1, eleven_multilingual_v2, eleven_flash_v2_5, eleven_turbo_v2_5
VOICE_ID=google-gemini-neural
TTS_MODEL=gemini-2.5-flash-preview-tts
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2

# Lokalny TTS Chatterbox (npm run tts-local) - głosy z prefiksem "local-", np. local-default
LOCAL_TTS_URL=http://127.0.0.1:8001
# Dozwolone warianty tts-local (domyślnie na Macu: cpu,mps). W pamięci jest zawsze jeden (~5 GB RAM). Czytane przez serwis Pythona, nie przez echo.
# CHATTERBOX_DEVICES=cpu
