# Port serwera
PORT=3000

# Klucze API (można również wprowadzić bezpośrednio w interfejsie aplikacji)
ELEVENLABS_API_KEY=twoj_klucz_elevenlabs
ANTHROPIC_API_KEY=twoj_klucz_anthropic
GOOGLE_API_KEY=twoj_klucz_google
GEMINI_API_KEY=twoj_klucz_gemini

# Model STT (Speech-to-Text)
# Opcje: gemini-3.5-transcribe, gemini-3.6-flash, web_speech, scribe_v2, scribe_v1
STT_MODEL=gemini-3.5-transcribe

# Model AI (LLM)
# Opcje: gemini-3.6-flash, gemini-flash-latest, gemini-3.8-flash, gemini-2.5-pro, claude-opus-5
AI_MODEL=gemini-3.6-flash
CLAUDE_MODEL=claude-opus-5

# Model TTS & Głos (Text-to-Speech)
# Głosy: google-gemini-neural, pl-PL-Wavenet-A, pl-PL-Wavenet-B, pl-PL-Wavenet-D, pl-PL-MarekNeural, pl-PL-ZofiaNeural, EXAVITQu4vr4xnSDxMaL
VOICE_ID=google-gemini-neural
TTS_MODEL=gemini-2.5-flash-preview-tts
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
