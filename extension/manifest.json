{
  "manifest_version": 3,
  "name": "Echo – czytaj zaznaczony tekst",
  "description": "Odczytuje na głos zaznaczony tekst przy użyciu serwera Echo (Gemini, Edge, WaveNet, ElevenLabs).",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "offscreen", "storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Echo – lektor",
    "default_popup": "popup.html"
  },
  "commands": {
    "read-selection": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Przeczytaj zaznaczony tekst"
    },
    "stop-reading": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Zatrzymaj czytanie"
    }
  }
}
