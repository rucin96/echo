{
  "name": "ai-voice-chat",
  "version": "1.0.0",
  "description": "Aplikacja do rozmowy głosowej z AI (Google Gemini & Claude + ElevenLabs / Web Speech)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "tts-local:setup": "python3.11 -m venv tts-local/.venv && tts-local/.venv/bin/pip install -r tts-local/requirements.txt",
    "tts-local": "tts-local/.venv/bin/python tts-local/server.py"
  },
  "keywords": [
    "voice",
    "gemini",
    "google",
    "claude",
    "elevenlabs",
    "stt",
    "tts",
    "ai-chat"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "msedge-tts": "^2.0.7",
    "multer": "^1.4.5-lts.1"
  }
}
